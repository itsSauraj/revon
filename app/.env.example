# Copy to .env.local and fill in. Never commit .env.local.

# ============================ REQUIRED ============================ #

# --- Google Maps Platform --- #
# Used for the native map (Android + iOS) and, unless overridden below, for Places + Routes.
# Enable on this key: Maps SDK for Android, Maps SDK for iOS, Places API (New), Routes API.
GOOGLE_MAPS_API_KEY=

# --- Firebase (Project settings > General > Your apps > Web app config) --- #
# Auth + Realtime Database (web build). Setup steps: ../backend/README.md
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Firebase native config files (Android / iOS) --- #
# Not env vars: put google-services.json and GoogleService-Info.plist in app/ (see backend/README.md).
# The Google Sign-In web client ID is read from google-services.json automatically.

# ============================ OPTIONAL ============================ #

# Override the Google Sign-In web OAuth client ID (normally read from google-services.json).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Paths to the Firebase config files, e.g. EAS file env vars (defaults: ./google-services.json, ./GoogleService-Info.plist).
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICES_PLIST=
# Leave empty to fall back to GOOGLE_MAPS_API_KEY. Recommended before release.

# Native map keys restricted to the Android package / iOS bundle id (com.velobits.Revon).
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=

# Key for Places API (New) + Routes API REST calls. Must NOT be restricted to Android/iOS apps
# (REST calls would be rejected) — restrict it by API instead.
EXPO_PUBLIC_GOOGLE_API_KEY=
