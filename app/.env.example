# Copy to .env.local and fill in. Never commit .env.local.

# ============================ REQUIRED ============================ #

# --- Google Maps Platform --- #
# Used for the native map (Android + iOS) and, unless overridden below, for Places + Routes.
# Enable on this key: Maps SDK for Android, Maps SDK for iOS, Places API (New), Routes API.
GOOGLE_MAPS_API_KEY=

# --- Firebase (Project settings > General > Your apps > Web app config) --- #
# Realtime Database + Anonymous Auth. Setup steps: ../backend/README.md
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ============================ OPTIONAL ============================ #
# Leave empty to fall back to GOOGLE_MAPS_API_KEY. Recommended before release.

# Native map keys restricted to the Android package / iOS bundle id (com.velobits.Revon).
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=

# Key for Places API (New) + Routes API REST calls. Must NOT be restricted to Android/iOS apps
# (REST calls would be rejected) — restrict it by API instead.
EXPO_PUBLIC_GOOGLE_API_KEY=
