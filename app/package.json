  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "start:usb": "node ./scripts/start-usb.js",
    "start:usb:clear": "node ./scripts/start-usb.js --clear",
    "go": "expo start --go",
    "go:clear": "expo start --go --clear",
    "go:tunnel": "expo start --go --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "android:dev": "expo run:android",
    "android:release": "expo run:android --variant release",
    "apk": "node scripts/build-apk.js",
    "postinstall": "node scripts/sync-web-assets.js",
    "ios:dev": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "build:dev:android": "npx eas-cli@latest build --profile development --platform android",
    "build:dev:ios": "npx eas-cli@latest build --profile development --platform ios",
    "build:preview:android": "npx eas-cli@latest build --profile preview --platform android",
    "build:preview:ios": "npx eas-cli@latest build --profile preview --platform ios",
    "build:prod:android": "npx eas-cli@latest build --profile production --platform android",
    "build:prod:ios": "npx eas-cli@latest build --profile production --platform ios",
    "build:prod": "npx eas-cli@latest build --profile production --platform all",
    "submit:android": "npx eas-cli@latest submit --profile production --platform android",
    "submit:ios": "npx eas-cli@latest submit --profile production --platform ios",
    "env:push:dev": "npx eas-cli@latest env:push development",
    "env:push:preview": "npx eas-cli@latest env:push preview",
    "env:push:prod": "npx eas-cli@latest env:push production",
    "env:pull:dev": "npx eas-cli@latest env:pull development",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "doctor": "expo-doctor",
    "check": "npm run typecheck && npm run lint && npm run doctor"
  },
  "private": true
}
